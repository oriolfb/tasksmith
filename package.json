{
  "name": "task-smith",
  "version": "0.7.0",
  "description": "Obsidian plugin: robust task console over Tasks-compatible markdown",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:watch": "node esbuild.config.mjs deploy-watch",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "audit:vault": "jest src/__tests__/vaultAudit.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "Oriol Farré",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jest": "^29.5.0",
    "jiti": "^2.6.1",
    "obsidian": "1.13.1",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "5.0.4",
    "typescript-eslint": "^8.59.1"
  }
}
