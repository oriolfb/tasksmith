    "esbuild": "^0.19.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "obsidian": "latest"
  }
